# Database Configuration
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=esedu_tiketti_db

# Prisma Database URL (päivitetty portti)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5434/${POSTGRES_DB}?schema=public"

# Application Configuration
NODE_ENV=development
ENVIRONMENT=development
PORT=3001
FRONTEND_URL=http://localhost:3000
# Backend URL for self-referential API calls (important for Docker)
# In Docker: http://backend:3001
# In development: http://localhost:3001
BACKEND_URL=http://localhost:3001

# JWT Configuration
JWT_SECRET=your-super-secret-key-here-minimum-32chars

# Azure AD (PAKOLLINEN)
# Ilman näitä backend hylkää kaikki todennetut pyynnöt.
# Arvojen tulee vastata frontendin VITE_MSAL_TENANT_ID- ja
# VITE_MSAL_CLIENT_ID-asetuksia: frontend lähettää ID-tokenin,
# jonka aud on client id ja iss sisältää tenant id:n.
AZURE_TENANT_ID=your-tenant-guid
AZURE_CLIENT_ID=your-client-guid

# Tokenin tarkistuksen tila:
#   enforce (oletus) = kelpaamaton token hylätään
#   warn             = kelpaamaton token hyväksytään ja syy lokitetaan
# Käytä warn-tilaa VAIN väliaikaisesti käyttöönoton diagnosointiin.
# Warn-tilassa järjestelmä on käytännössä ilman todennusta.
# AUTH_VERIFY_MODE=warn






OPENAI_API_KEY=sk-proj-1234567890
OPENAI_COMPLETION_MODEL=gpt-4.1



# Discord Integration
# Get these from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
# Optional: Discord category ID for organizing ticket channels
# DISCORD_TICKET_CATEGORY_ID=1234567890123456789